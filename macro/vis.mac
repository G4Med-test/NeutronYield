/control/verbose 0
/run/verbose 0

/NeutronYield/Geometry/Target/SetThickness 10 cm
/NeutronYield/Geometry/Target/SetRadius    5 cm
/NeutronYield/Geometry/Target/SetMaterial G4_WATER #Iron

/run/numberOfThreads 1

/NeutronYield/PhysicsList/AddPhysics  proton_BIC_em_standard_opt4

/run/initialize

#/GB04/biasing/setSplittingFactor 1000
#/GB04/biasing/biasPrimaryOnly false
#/GB04/biasing/biasOnlyOnce    false

#
/vis/open OGL

/vis/viewer/set/autoRefresh false
/vis/verbose errors
/vis/drawVolume
/vis/viewer/set/viewpointThetaPhi 0 90 
/vis/viewer/zoom 1

# as markers 2 pixels wide:
/vis/scene/add/trajectories smooth

# Draw hits at end of event:
/vis/scene/add/hits

# To superimpose all of the events from a given run:
/vis/scene/endOfEventAction accumulate
#
# Re-establish auto refreshing and verbosity:
/vis/viewer/set/autoRefresh true
/vis/verbose warnings

/gps/particle ion
/gps/ion 6 12 6
#/gps/position 0. 0. 0. cm
#/gps/ene/type Gauss
/gps/ene/mono 2244 MeV
#/gps/direction 1 0 0

/gps/verbose 0
#/gps/particle proton
#/gps/ion 6 12 6
#/gps/ene/mono 113 MeV
/gps/direction 1 0 0
/gps/position -25 0 0 cm #0.0 0.0 -5.03 cm
/gps/pos/type Point

/analysis/setFileName vis

/run/printProgress 5
/run/beamOn 1

